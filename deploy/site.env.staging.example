# =============================================================================
# Production runtime environment for edupro-site (vitrine) — STAGING.
#
# Deploy as  /opt/edupro-site/staging.env  (root:root 600) on the Droplet
# BEFORE the first staging deploy — the workflow refuses to run if it's missing.
#
#   ssh support@<droplet>
#   sudo mkdir -p /opt/edupro-site
#   sudo install -m 600 /dev/stdin /opt/edupro-site/staging.env <<'EOF'
#     ...filled version below...
#   EOF
#
# Rotating a secret: edit + `docker restart edupro-site-staging`. No rebuild
# needed for runtime vars.
#
# NOTE: NEXT_PUBLIC_* are NOT in this file — they are baked into the Docker
# image at build time via GitHub Environment secrets (staging) and re-injected
# at runtime by the workflow's `docker run -e ...` flags.
# =============================================================================

# --- Supabase (server-side only) ---
# Service role key for the STAGING Supabase project (qofruhdfxvqfsdursqjv).
# Never prefix with NEXT_PUBLIC_ — bypasses RLS, must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=<staging-supabase-service-role-key>

# --- reCAPTCHA v3 (public forms) ---
RECAPTCHA_SECRET_KEY=<staging-recaptcha-secret-key>

# --- Cloudflare Turnstile (auth) ---
TURNSTILE_SECRET_KEY=<staging-turnstile-secret-key>

# --- Resend (transactional emails) ---
# Optional: code logs an error and skips sending if RESEND_API_KEY is unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
