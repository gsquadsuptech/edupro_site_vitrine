# =============================================================================
# Production runtime environment for edupro-site (vitrine) — PROD.
#
# Deploy as  /opt/edupro-site/prod.env  (root:root 600) on the Droplet
# BEFORE the first prod deploy — the workflow refuses to run if it's missing.
#
#   ssh support@<droplet>
#   sudo mkdir -p /opt/edupro-site
#   sudo install -m 600 /dev/stdin /opt/edupro-site/prod.env <<'EOF'
#     ...filled version below...
#   EOF
#
# Rotating a secret: edit + `docker restart edupro-site-prod`. No rebuild
# needed for runtime vars.
#
# NOTE: NEXT_PUBLIC_* are NOT in this file — they are baked into the Docker
# image at build time via GitHub Environment secrets (production) and re-injected
# at runtime by the workflow's `docker run -e ...` flags.
# =============================================================================

# --- Supabase (server-side only) ---
# Service role key for the PROD Supabase project (cgvetdddfskhrrjziiig).
# Never prefix with NEXT_PUBLIC_ — bypasses RLS, must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=<prod-supabase-service-role-key>

# --- reCAPTCHA v3 (public forms) ---
RECAPTCHA_SECRET_KEY=<prod-recaptcha-secret-key>

# --- Cloudflare Turnstile (auth) ---
TURNSTILE_SECRET_KEY=<prod-turnstile-secret-key>

# --- Resend (transactional emails) ---
RESEND_API_KEY=<prod-resend-api-key>
RESEND_FROM_EMAIL=<noreply-or-contact>@edupro.africa
